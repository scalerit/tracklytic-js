{
  "name": "tracklytic",
  "version": "2.0.0",
  "description": "Tracklytic Client - Real-time event tracking and analytics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:deno": "denoify",
    "build:vite": "tsc && vite build",
    "dev:vite": "vite",
    "publish-lib": "npm run build && npm publish",
    "publish-beta": "npm run build && npm publish --tag beta",
    "publish-dryrun": "npm run build && npm publish --dry-run",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "lint": "eslint --ext .ts src",
    "test": "npm run build && tsc -p tsconfig.types.json && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalerit/tracklytic-js.git"
  },
  "keywords": [
    "tracklytic",
    "analytics",
    "events",
    "tracking",
    "insights",
    "real-time"
  ],
  "author": "Tracklytic Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scalerit/tracklytic-js/issues"
  },
  "homepage": "https://docs.tracklytic.de/sdks/javascript/",
  "dependencies": {
    "isomorphic-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^17.0.8",
    "@typescript-eslint/eslint-plugin": "^5.9.0",
    "@typescript-eslint/parser": "^5.9.0",
    "denoify": "^1.4.1",
    "eslint": "^8.6.0",
    "prettier": "^2.5.1",
    "typescript": "^4.2.3",
    "vite": "^3.2.7"
  },
  "files": [
    "dist"
  ]
}
